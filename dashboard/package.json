{
  "name": "dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "validate:lp-schema": "node scripts/validate-lp-schema.mjs",
    "guard:config-page": "node scripts/guard-config-page-regression.mjs",
    "validate:seo-consistency": "node scripts/validate-seo-consistency.mjs",
    "validate:core-schema": "node scripts/validate-core-schema.mjs",
    "guard:seo-registry": "node scripts/guard-seo-registry-coverage.mjs",
    "lint:seo-metadata": "node scripts/lint-seo-metadata-duplicates.mjs",
    "validate:schema-templates": "node scripts/validate-schema-templates.mjs",
    "validate:seo-p0": "npm run guard:seo-registry && npm run lint:seo-metadata",
    "validate:editorial-freshness": "node scripts/validate-editorial-freshness.mjs",
    "monitor:cwv-budget": "node scripts/monitor-cwv-budget.mjs",
    "validate:seo-p2": "npm run validate:editorial-freshness && npm run monitor:cwv-budget",
    "smoke:mobile-routes": "node scripts/smoke-mobile-routes.mjs",
    "smoke:mobile-p1": "node scripts/smoke-mobile-p1.mjs",
    "smoke:mobile-p2": "node scripts/smoke-mobile-p2.mjs",
    "smoke:mobile-p3": "node scripts/smoke-mobile-p3.mjs"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4",
    "next": "16.2.4",
    "qrcode.react": "^4.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4"
  }
}
