# Optional, read-only Hetzner capacity inventory. Never expose this token to the dashboard.
HCLOUD_READ_TOKEN=
HCLOUD_PROJECT_ID=14422101
HCLOUD_SERVER_ID=128727108

# Capacity collection runs inside the existing API process. Paths must be absolute roots.
CAPACITY_PRODUCTION_ROOT=/home/deploy/wabot
CAPACITY_STAGING_ROOT=/home/deploy/wabot-staging
CAPACITY_SWEEP_INTERVAL_MS=300000
# ADMIN > Capacidade: dados manuais do contrato (opcionais; token Hetzner é read-only)
# CAPACITY_HETZNER_QUOTA_JSON={"servers":{"used":1,"limit":10}}
# CAPACITY_MONTHLY_COST_EUR=6.49
# CAPACITY_CONTRACT_CHECKED_AT=2026-08-27

# Feature 017 (arquitetura multicanal de entrega — WhatsApp, Telegram e Story
# do Instagram). Lidas SÓ fora do processo por conta (na API, na montagem da
# configuração) — NUNCA pelo bot-worker nem pelo bot-supervisor. Aplicar
# qualquer uma destas exige `pm2 delete` + `start` da API (pegadinha #1),
# NUNCA `pm2 restart bot-supervisor` (isso reconectaria todas as sessões de
# WhatsApp à toa — o Telegram nunca mora no processo de sessão).
#
# DELIVERY_NETWORKS_ENABLED: lista separada por vírgula das redes de entrega
# habilitadas além do WhatsApp (que está sempre ligado e nunca passa por este
# interruptor). Default (ausente) = só "whatsapp" — nenhum destino/origem de
# outro aplicativo chega a existir na config do worker.
# DELIVERY_NETWORKS_ENABLED=whatsapp,telegram

# TELEGRAM_BOT_TOKEN: segredo de INFRAESTRUTURA do robô único do produto
# (D1 da spec 017) — nunca credencial de cliente, nunca aparece em tela, log,
# e-mail ou tabela de credencial de loja. Ausente por padrão; sem ele, o
# leitor/drenador do Telegram (Fatia 3) não inicia (fail-safe silencioso, no
# padrão do motor de e-mails sem SMTP).
# TELEGRAM_BOT_TOKEN=

# DELIVERY_FAIR_SHARE_PER_USER: teto de itens por conta, por tick, no
# rodízio da caixa de saída do robô único — nenhuma conta em volume alto
# consome a fatia das demais (FR-039/D-A7). Calibrar em homologação (Q6).
# DELIVERY_FAIR_SHARE_PER_USER=

# DELIVERY_OUTBOX_SWEEP_INTERVAL_MS: intervalo da passada que drena
# DeliveryOutbox dentro do processo `api` (setInterval + unref, D-A6) —
# nenhum processo PM2 novo.
# DELIVERY_OUTBOX_SWEEP_INTERVAL_MS=

# Anti-banimento (unificação de 018-unificar-protecao-anti-ban) — escape hatches
# de rollback, sem redeploy. Ausente/qualquer valor != 'off' = ligado; só 'off'
# desliga. Aplicar exige `pm2 delete` + `start` (pegadinha #1) e, em modo
# `remote`, reiniciar o bot-supervisor (reconecta TODAS as sessões).
# ANTI_BAN_FLOOR=off        # desliga o piso de 3 campos fixos (rajada/janela/liga-desliga)
# DESTINATION_SPACING=off   # desliga o intervalo entre destinos (nunca volta ao sleep antigo)
