{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": [
    "src/domain/**/*.js",
    "src/app/**/*.js",
    "src/api/routes/payments.js"
  ],
  "exclude": [
    "node_modules",
    "dashboard",
    "test",
    "prisma"
  ]
}
