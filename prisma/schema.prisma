// Feature 017 (arquitetura multicanal de entrega) — a oferta esperando para
// sair num aplicativo que NÃO é WhatsApp. O worker nunca fala HTTP com essas
// redes: quando um destino não é WhatsApp, ele grava uma linha aqui e segue
// (D-A6 do plano). Quem drena é uma passada dentro do processo `api`
// (Fatia 3), nunca dentro do processo por conta.
model DeliveryOutbox {
  id              String    @id @default(cuid())
  userId          String
  deliveryNetwork String // 'telegram' | (futuro) 'instagram'
  destinationId   String // identificador namespaceado: 'tg:-100...'
  sourceId        String? // origem, quando veio de espelhamento
  messageLogId    String? // linha do histórico que esta entrega atualiza
  offerJson       String // a oferta NEUTRA (src/core/delivery/neutralOffer.js), serializada
  status          String    @default("pending") // pending | sending | done | failed | dropped
  attempts        Int       @default(0)
  notBeforeAt     DateTime? // espera por orçamento/limite do aplicativo — NUNCA descarte (FR-040)
  enqueuedAt      DateTime  @default(now())
  lastError       String? // motivo próprio, já dentro da taxonomia de falha por rede
  updatedAt       DateTime  @updatedAt

  @@index([status, notBeforeAt])
  @@index([userId, status])
  @@index([deliveryNetwork, status])
}

// Feature 017 (arquitetura multicanal de entrega) — "esta mensagem de origem
// já foi processada". A gravação acontece ANTES do fan-out; colisão na
// chave única = mensagem já processada, e o processamento para ali. É o que
// faz FR-055/SC-016 valerem mesmo entre processos diferentes (uma janela em
// memória não sobreviveria a um restart da API). Populada só na Fatia 5
// (Telegram como origem) — a tabela nasce nesta fatia para o schema já
// acomodar a origem sem migração destrutiva futura.
model DeliveryInboxSeen {
  id              String   @id @default(cuid())
  deliveryNetwork String
  sourceId        String // grupo de origem, namespaceado
  messageId       String // id da mensagem no aplicativo de origem
  seenAt          DateTime @default(now())

  @@unique([deliveryNetwork, sourceId, messageId])
  @@index([seenAt])
}

// Contas Awin da cliente (docs/rca/afiliados-awin.md). O token da Awin é do
// USUÁRIO Awin (serve para várias contas de publisher); cada linha aqui é um
// par (Publisher ID + token) cadastrado pela cliente. Isolamento: toda
// consulta filtra por userId.
model AwinAccount {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  label               String
  publisherId         String
  // encryptCredential (AES-256-GCM, "v1:..."). Nunca volta ao navegador.
  tokenEncrypted      String
  tokenLast4          String
  // HMAC-SHA256 do token: chave do limitador de chamadas (20/min por token
  // na Awin). Não permite recuperar o token.
  tokenFingerprint    String
  // pending | ok | invalid_credential | error
  status              String    @default("pending")
  statusDetail        String?
  syncEnabled         Boolean   @default(true)
  syncIntervalMinutes Int       @default(60)
  nextSyncAt          DateTime?
  lastSyncAt          DateTime?
  lastSyncStatus      String?
  lastTestAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  promotions          AwinPromotion[]
  syncRuns            AwinSyncRun[]
  programmes          AwinProgramme[]
  links               AwinLink[]

  @@unique([userId, publisherId])
  @@index([userId])
  @@index([syncEnabled, status, nextSyncAt])
}

// Promoção importada (type=promotion; cupons/vouchers ficam de fora).
// Dedup por (conta, promotionId): duas contas podem ter a mesma promoção,
// cada uma com o próprio link de afiliado.
model AwinPromotion {
  id             String    @id @default(cuid())
  userId         String
  accountId      String
  account        AwinAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  promotionId    String
  advertiserId   String
  advertiserName String
  title          String
  description    String    @default("")
  terms          String    @default("")
  url            String?
  urlTracking    String
  regionsJson    String    @default("{}")
  startDate      DateTime?
  endDate        DateTime?
  dateAdded      DateTime?
  // active | expired
  status         String    @default("active")
  lastSeenRunId  String?
  // Preenchidos só na hora do PRIMEIRO envio (docs/rca/afiliados-awin.md):
  // link curto do gerador oficial da Awin e foto lida da página da loja.
  // enrichedAt marca a tentativa do link curto — falhou, tenta de novo em 24h.
  shortUrl       String?
  imageUrl       String?
  enrichedAt     DateTime?
  // Última tentativa de FOTO (separada: foto é tentada de novo em 1h).
  imageTriedAt   DateTime?
  firstSeenAt    DateTime  @default(now())
  expiredAt      DateTime?
  updatedAt      DateTime  @updatedAt

  @@unique([accountId, promotionId])
  @@index([userId, status, endDate])
  @@index([accountId, status])
}

// Histórico de sincronização por conta (o que a cliente vê na tela).
model AwinSyncRun {
  id         String    @id @default(cuid())
  userId     String
  accountId  String
  account    AwinAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  // schedule | manual
  trigger    String
  // running | success | partial | failed | invalid_credential | rate_limited
  status     String
  pages      Int       @default(0)
  inserted   Int       @default(0)
  updated    Int       @default(0)
  skipped    Int       @default(0)
  expired    Int       @default(0)
  errorsJson String    @default("[]")
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([accountId, startedAt])
}

// Loja em que a conta Awin foi APROVADA (joined, Brasil). Vem do sync de hora
// em hora (GET /publishers/{id}/programmes). É daqui que a conversão de links
// sabe de qual loja é uma URL (docs/rca/afiliados-awin.md).
model AwinProgramme {
  id             String      @id @default(cuid())
  userId         String
  accountId      String
  account        AwinAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  advertiserId   Int
  name           String
  displayUrl     String?
  // Logo da loja (programmes.logoUrl): foto de último recurso das promoções.
  logoUrl        String?
  // Domínios normalizados ("kabum.com.br", "kabum.com"), JSON array.
  domainsJson    String      @default("[]")
  lastSeenRunId  String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([accountId, advertiserId])
  @@index([userId])
}

// Link convertido pela Awin, guardado para reuso: o mesmo produto não gasta
// outra chamada nem outro link curto (cota medida: 200 por dia por conta).
model AwinLink {
  id              String      @id @default(cuid())
  userId          String
  accountId       String
  account         AwinAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  advertiserId    Int
  // Hash da página de destino limpa (sem utm): chave do reuso.
  destinationKey  String
  destinationUrl  String
  shortUrl        String?
  longUrl         String
  createdAt       DateTime    @default(now())
  lastUsedAt      DateTime    @default(now())

  @@unique([accountId, advertiserId, destinationKey])
  @@index([userId])
  @@index([lastUsedAt])
}

// Contas Rakuten Advertising da cliente (docs/rca/afiliados-rakuten.md).
// Cada linha é um trio (SID + Client ID + Client Secret) cadastrado pela
// cliente. Isolamento: toda consulta filtra por userId.
model RakutenAccount {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  label                 String
  // SID = número do site da cliente na Rakuten (vai como "scope" do token).
  sid                   String
  // encryptCredential (AES-256-GCM, "v1:..."). Nunca voltam ao navegador.
  clientIdEncrypted     String
  clientIdLast4         String
  clientSecretEncrypted String
  clientSecretLast4     String
  // HMAC-SHA256 do trio: chave do limitador e do cache de token.
  credentialFingerprint String
  // pending | ok | invalid_credential | error
  status                String    @default("pending")
  statusDetail          String?
  syncEnabled           Boolean   @default(true)
  syncIntervalMinutes   Int       @default(60)
  nextSyncAt            DateTime?
  lastSyncAt            DateTime?
  lastSyncStatus        String?
  lastTestAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  // `id` dos links da cliente na Rakuten (tirado do clickurl das promoções).
  // Monta o deep link da conversão; null = ainda não deu para saber.
  linkId                String?
  promotions            RakutenPromotion[]
  syncRuns              RakutenSyncRun[]
  programmes            RakutenProgramme[]

  @@unique([userId, sid])
  @@index([userId])
  @@index([syncEnabled, status, nextSyncAt])
}

// Oferta importada do feed da Rakuten (/coupon/1.0, rede Brasil). Dedup por
// (conta, promotionId = offerid do link). couponCode só quando a loja deu
// um cupom. logoUrl/storeUrl vêm do cadastro da loja (/v2/advertisers).
model RakutenPromotion {
  id             String    @id @default(cuid())
  userId         String
  accountId      String
  account        RakutenAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  promotionId    String
  advertiserId   String
  advertiserName String
  title          String
  couponCode     String?
  promotionTypes String    @default("")
  categories     String    @default("")
  clickUrl       String
  networkId      String?
  logoUrl        String?
  storeUrl       String?
  startDate      DateTime?
  endDate        DateTime?
  // active | expired
  status         String    @default("active")
  lastSeenRunId  String?
  firstSeenAt    DateTime  @default(now())
  expiredAt      DateTime?
  updatedAt      DateTime  @updatedAt

  @@unique([accountId, promotionId])
  @@index([userId, status, endDate])
  @@index([accountId, status])
}

// Histórico de sincronização por conta Rakuten (o que a cliente vê na tela).
model RakutenSyncRun {
  id         String    @id @default(cuid())
  userId     String
  accountId  String
  account    RakutenAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  // schedule | manual
  trigger    String
  // running | success | partial | failed | invalid_credential | rate_limited
  status     String
  pages      Int       @default(0)
  inserted   Int       @default(0)
  updated    Int       @default(0)
  skipped    Int       @default(0)
  expired    Int       @default(0)
  errorsJson String    @default("[]")
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([accountId, startedAt])
}

// Lojas da Rakuten em que a cliente foi APROVADA (Link Locator) — base da
// conversão de links (docs/rca/afiliados-rakuten.md). Atualizada no sync.
model RakutenProgramme {
  id            String         @id @default(cuid())
  userId        String
  accountId     String
  account       RakutenAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  advertiserId  String
  name          String
  // Site da loja (/v2/advertisers/{id} → url); de onde sai o domínio.
  storeUrl      String?
  // Domínios normalizados ("netshoes.com.br"), JSON array.
  domainsJson   String         @default("[]")
  lastSeenRunId String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([accountId, advertiserId])
  @@index([userId])
}
