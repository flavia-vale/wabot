generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  passwordHash   String
  plan           String    @default("trial")
  trialExpiresAt DateTime?
  sendCount      Int       @default(0)
  referralCode   String?   @unique
  referredBy     String?
  createdAt      DateTime  @default(now())

  waSession   WaSession?
  groups      Group[]
  groupTargets GroupTarget[]
  credentials Credential[]
  payments    Payment[]
  botConfig   BotConfig?
  scheduled   ScheduledMessage[]
  messageLogs MessageLog[]
}

model WaSession {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone     String?
  status    String   @default("disconnected")
  updatedAt DateTime @updatedAt
}

model Group {
  id                 String  @id @default(cuid())
  userId             String
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  waJid              String
  name               String
  role               String
  imageMode          String  @default("none")
  imageLinkTarget    String  @default("first")
  fallbackToOriginal Boolean @default(false)
  blockedKeywords   String?
  allowedPlatforms  String?
  welcomeMsg        String?
  monitorTargets   GroupTarget[] @relation("MonitorTargets")
  postTargets      GroupTarget[] @relation("PostTargets")

  @@unique([userId, waJid, role])
}

model GroupTarget {
  id        String @id @default(cuid())
  userId    String
  monitorId String
  postId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  monitor   Group  @relation("MonitorTargets", fields: [monitorId], references: [id], onDelete: Cascade)
  post      Group  @relation("PostTargets", fields: [postId], references: [id], onDelete: Cascade)

  @@unique([monitorId, postId])
  @@index([userId])
  @@index([postId])
}

model Credential {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform String
  data     String

  @@unique([userId, platform])
}

model Payment {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mpPaymentId String?   @unique
  plan        String
  status      String    @default("pending")
  amount      Float
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
}

model BotConfig {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  delayMin        Int      @default(5)
  delayMax        Int      @default(15)
  platforms       String   @default("shopee,amazon,mercadolivre,magazineluiza")
  blockedKeywords String   @default("")
  welcomeMsg      String   @default("")
  feedGlobal      Boolean  @default(false)
  postToStatus    Boolean  @default(false)
  updatedAt       DateTime @updatedAt
}

model ScheduledMessage {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  text        String
  targetJids  String
  scheduledAt DateTime
  sentAt      DateTime?
  status      String    @default("pending")
  createdAt   DateTime  @default(now())

  @@index([userId, status, scheduledAt])
}

model MessageLog {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform     String
  sourceGroup  String
  destGroup    String
  originalUrl  String
  convertedUrl String
  messageText  String
  status       String   @default("success")
  errorMsg     String?
  sentAt       DateTime @default(now())

  @@index([userId, sentAt])
  @@index([userId, status, sentAt])
}


model AnalyticsEvent {
  id        String   @id
  userId    String?
  event     String
  metadata  String   @default("{}")
  createdAt DateTime @default(now())

  @@index([event, createdAt])
  @@index([userId, createdAt])
}


model AnalyticsEvent {
  id        String   @id
  userId    String?
  event     String
  metadata  String   @default("{}")
  createdAt DateTime @default(now())

  @@index([event, createdAt])
  @@index([userId, createdAt])
}


model AnalyticsEvent {
  id        String   @id
  userId    String?
  event     String
  metadata  String   @default("{}")
  createdAt DateTime @default(now())

  @@index([event, createdAt])
  @@index([userId, createdAt])
}
