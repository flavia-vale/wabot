model OfferAutomation {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  destGroupJid    String
  destGroupName   String
  keyword         String
  templateKey     String    @default("automatico_classico")
  intervalMinutes Int
  dailyRunTime    String?
  offersPerSend   Int       @default(1)
  minDiscountPct  Int       @default(0)
  sortType        Int       @default(2)
  listType        Int       @default(1)
  prioritizeAMS   Boolean   @default(false)
  isKeySeller     Boolean   @default(false)
  enabled         Boolean   @default(true)
  lastSentAt      DateTime?
  sentItemIds     String    @default("[]")
  // Página atual da busca Shopee. Rotaciona a cada execução para que cada
  // disparo traga candidatos novos em vez de rebater sempre a página 1 (o que
  // causava all_offers_filtered em nichos pequenos já enviados no dia).
  page            Int       @default(1)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId, enabled])
  @@index([enabled, lastSentAt])
}

// Dedup cruzada entre automações, por grupo de destino. `sentItemIds` é
// per-automação, então N automações apontando pro mesmo grupo reenviavam o
// MESMO produto (uma vez por automação). Aqui registramos cada produto
// enviado a um grupo COM o preço; antes de enviar, o dispatcher pula se o
// mesmo (userId, destGroupJid, productKey, priceCents) saiu nas últimas 24h.
// Se o PREÇO mudou, a oferta passa (é uma oferta nova de fato — relâmpago da
// manhã a R$X vs. da tarde a R$Y).
model OfferAutomationSentLog {
  id           String   @id @default(cuid())
  userId       String
  destGroupJid String
  productKey   String
  priceCents   Int
  itemId       String?
  sentAt       DateTime @default(now())

  @@index([userId, destGroupJid, sentAt])
}

model AffiliateSettings {
  id                         Int     @id @default(1)
  cookieDurationHours        Int     @default(24)
  commissionPercent          Int     @default(30)
  commissionRecurringPercent Int     @default(30)
  recurringCommissionEnabled Boolean @default(true)
  commissionHoldDays         Int     @default(30)
  attributionWindowDays      Int     @default(30)
  attributionModel           String  @default("last_non_direct")
  // 009-affiliate-improvements-r1 (US2): valor mínimo (em centavos) para o
  // afiliado poder solicitar saque self-service.
  minPayoutCents             Int     @default(5000)
  // 009-affiliate-improvements-r1 (US4): janela (dias) e modo de endurecimento
  // da atribuição órfã por dispositivo. orphanTouchMode ∈ off|window|hold|both.
  orphanTouchWindowDays      Int     @default(7)
  orphanTouchMode            String  @default("both")
  // 009-affiliate-improvements-r1 (US2): kill-switch de rollout do saque self-service.
  payoutRequestsEnabled      Boolean @default(true)
}

// 009-affiliate-improvements-r1 (US2): pedido de saque self-service do
// afiliado. Estados: requested -> paid | rejected. O valor é sempre um
// snapshot do saldo disponível calculado no servidor (nunca vem do cliente).
model AffiliatePayoutRequest {
  id                   String    @id @default(cuid())
  affiliateId          String
  amountCents          Int
  status               String    @default("requested")
  requestedAt          DateTime  @default(now())
  resolvedAt           DateTime?
  resolvedByUserId     String?
  rejectionReason      String?
  settledCommissionIds String?
  createdAt            DateTime  @default(now())

  affiliate  AffiliateProfile @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  resolvedBy User?            @relation("ResolvedPayoutRequests", fields: [resolvedByUserId], references: [id])

  @@index([affiliateId, status])
  @@index([status, requestedAt])
}

model AffiliateProfile {
  id                                 String    @id @default(cuid())
  userId                             String    @unique
  code                               String    @unique
  status                             String    @default("pending")
  pixKey                             String
  pixKeyType                         String
  appliedAt                          DateTime  @default(now())
  approvedAt                         DateTime?
  rejectedAt                         DateTime?
  adminNotes                         String?
  commissionPercentOverride          Int?
  commissionRecurringPercentOverride Int?

  user               User                        @relation("UserAffiliate", fields: [userId], references: [id], onDelete: Cascade)
  referredUsers      User[]                      @relation("AffiliateUser")
  commissions        AffiliateCommission[]
  attributionTouches AffiliateAttributionTouch[]
  payoutRequests     AffiliatePayoutRequest[]

  @@index([status])
}

model AffiliateAttributionTouch {
  id            String   @id @default(cuid())
  affiliateId   String
  affiliateCode String?
  clickId       String?
  visitorId     String?
  userId        String?
  source        String?
  medium        String?
  campaign      String?
  landingPage   String?
  ipHash        String?
  uaHash        String?
  touchedAt     DateTime @default(now())

  affiliate AffiliateProfile @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  user      User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([affiliateId, touchedAt])
  @@index([userId, touchedAt])
  @@index([visitorId, touchedAt])
  @@index([clickId])
}

model AffiliateCommission {
  id                    String    @id @default(cuid())
  affiliateId           String
  paymentId             String    @unique
  referredUserId        String
  saleAmountCents       Int
  commissionAmountCents Int
  commissionType        String    @default("initial")
  commissionRatePct     Int       @default(30)
  status                String    @default("pending")
  cycleMonth            String
  eligibleAt            DateTime?
  approvedAt            DateTime?
  approvedByUserId      String?
  heldAt                DateTime?
  holdReason            String?
  reversedAt            DateTime?
  reversalReason        String?
  paidAt                DateTime?
  paidByUserId          String?
  createdAt             DateTime  @default(now())

  affiliate     AffiliateProfile            @relation(fields: [affiliateId], references: [id])
  payment       Payment                     @relation(fields: [paymentId], references: [id])
  referredUser  User                        @relation("ReferredUserCommissions", fields: [referredUserId], references: [id])
  paidBy        User?                       @relation("PaidCommissions", fields: [paidByUserId], references: [id])
  approvedBy    User?                       @relation("ApprovedCommissions", fields: [approvedByUserId], references: [id])
  ledgerEntries AffiliateCommissionLedger[]

  @@index([affiliateId, cycleMonth, status])
  @@index([status, eligibleAt])
  @@index([referredUserId])
}

// Ledger append-only de movimentação financeira de comissão (R3). Toda transição
// de status (criação, hold->eligible, aprovação, reversão, pagamento) grava UMA
// linha aqui — trilha imutável para auditoria/disputa. O saldo do afiliado
// continua DERIVADO de AffiliateCommission; este ledger nunca sofre UPDATE.
model AffiliateCommissionLedger {
  id           String   @id @default(cuid())
  commissionId String
  affiliateId  String?
  fromStatus   String?
  toStatus     String
  amountCents  Int      @default(0)
  reason       String?
  actor        String?
  createdAt    DateTime @default(now())

  commission AffiliateCommission @relation(fields: [commissionId], references: [id], onDelete: Cascade)

  @@index([commissionId, createdAt])
  @@index([affiliateId, createdAt])
}

// ---------------------------------------------------------------------------
// Motor de e-mails (fase 2 do plano de e-mails). O TEXTO PADRÃO de cada e-mail
// mora no código (src/email/registry.js); estas tabelas guardam só o que a
// admin muda pelo painel e o histórico do que saiu. Sem linha em EmailTemplate,
// vale o padrão do código — a aba de e-mails nunca deixa o sistema sem texto.
// ---------------------------------------------------------------------------

model EmailTemplate {
  slug            String   @id
  subject         String
  // Título que aparece DENTRO do corpo do e-mail (o <h1> acima do texto).
  // Nulo = usa o do catálogo em src/email/registry.js; string vazia = a admin
  // escolheu NÃO mostrar título nenhum. Antes o campo não existia aqui e o
  // título vinha sempre do código, sem jeito de editar nem tirar pelo painel.
  title           String?
  body            String
  enabled         Boolean  @default(true)
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Histórico + idempotência de TODO e-mail que sai (automático, manual ou teste).
// É também a trava anti-repetição: "já recebeu este e-mail nos últimos N dias"
// é uma consulta aqui. `userId` fica sem relação de propósito (mesmo padrão de
// AnalyticsEvent) para o log sobreviver à exclusão da conta.
model EmailSendLog {
  id          String    @id @default(cuid())
  slug        String
  userId      String?
  email       String
  category    String    @default("transactional")
  mode        String    @default("auto")
  batchId     String?
  status      String    @default("queued")
  skipReason  String?
  error       String?
  scheduledAt DateTime  @default(now())
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([slug, userId, createdAt])
  @@index([status, scheduledAt])
  @@index([batchId, status])
}

// Um disparo manual em massa feito pelo painel admin.
model EmailBatch {
  id              String    @id @default(cuid())
  slug            String
  createdByUserId String?
  filters         String    @default("{}")
  total           Int       @default(0)
  status          String    @default("running")
  createdAt       DateTime  @default(now())
  finishedAt      DateTime?

  @@index([status, createdAt])
}

// Descadastro por categoria (hoje só 'marketing'). E-mail transacional
// (cobrança, vencimento, segurança) NÃO passa por aqui — é obrigação de serviço.
model EmailOptOut {
  id        String   @id @default(cuid())
  userId    String
  category  String   @default("marketing")
  source    String?
  createdAt DateTime @default(now())

  @@unique([userId, category])
}

