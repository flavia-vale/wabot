generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                     String    @id @default(cuid())
  name                   String
  email                  String    @unique
  passwordHash           String
  contactPhone           String?   @unique
  contactPhoneVerifiedAt DateTime?
  contactPhoneOptInAt    DateTime?
  status                 String    @default("active")
  plan                   String    @default("trial")
  accessExpiresAt        DateTime?
  sendCount              Int       @default(0)
  referralCode           String?   @unique
  referredBy             String?
  lastLoginAt            DateTime?
  lastActivityAt         DateTime?
  lastSupportContactAt   DateTime?
  supportStatus          String    @default("new")
  termsAcceptedAt        DateTime?
  termsVersion           String?
  termsAcceptedIp        String?
  termsAcceptedUserAgent String?
  createdAt              DateTime  @default(now())

  waSession             WaSession?
  groups                Group[]
  groupTargets          GroupTarget[]
  credentials           Credential[]
  payments              Payment[]
  botConfig             BotConfig?
  scheduled             ScheduledMessage[]
  messageLogs           MessageLog[]
  adminUser             AdminUser?
  adminAuditActors      AdminAuditLog[]      @relation("AdminAuditActor")
  adminAuditTargets     AdminAuditLog[]      @relation("AdminAuditTarget")
  customerContacts      CustomerContactLog[]
  customerContactActors CustomerContactLog[] @relation("CustomerContactActor")
  followLogs            FollowLog[]
  offerAutomations      OfferAutomation[]
  offerQueues           OfferQueue[]
  offerQueueItems       OfferQueueItem[]
  affiliateLinks        AffiliateLink[]
  probeEvidences       ProbeEvidence[]

  affiliateProfileId    String?  @unique
  affiliateProfile      AffiliateProfile? @relation("UserAffiliate")
  affiliateRef          AffiliateProfile? @relation("AffiliateUser", fields: [affiliateProfileId], references: [id])
  referredCommissions   AffiliateCommission[] @relation("ReferredUserCommissions")
  paidCommissions       AffiliateCommission[] @relation("PaidCommissions")
  subscriptions         Subscription[]

  @@index([status, plan, accessExpiresAt])
  @@index([lastActivityAt])
  @@index([supportStatus])
}

model WaSession {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone            String?
  status           String   @default("disconnected")
  lifecycle        String   @default("idle")
  ownerInstance    String?
  lastHeartbeatAt  DateTime?
  lastDisconnectCode String?
  updatedAt        DateTime @updatedAt

  @@index([status, lastHeartbeatAt])
}

model Group {
  id                 String  @id @default(cuid())
  userId             String
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  waJid              String
  name               String
  role               String
  kind               String  @default("group")
  imageMode          String  @default("none")
  imageLinkTarget    String  @default("first")
  fallbackToOriginal Boolean @default(false)
  forwardMode       String   @default("LINK_ONLY")
  noLinkScope       String?
  blockedKeywords   String?
  allowedPlatforms  String?
  welcomeMsg        String?
  monitorTargets   GroupTarget[] @relation("MonitorTargets")
  postTargets      GroupTarget[] @relation("PostTargets")
  channelHealth    ChannelHealth?
  channelThrottle  ChannelThrottle?
  channelSnapshots ChannelSnapshot[]
  probeEvidences  ProbeEvidence[]

  @@unique([userId, waJid, role])
  @@index([userId, kind])
}

model GroupTarget {
  id        String @id @default(cuid())
  userId    String
  monitorId String
  postId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  monitor   Group  @relation("MonitorTargets", fields: [monitorId], references: [id], onDelete: Cascade)
  post      Group  @relation("PostTargets", fields: [postId], references: [id], onDelete: Cascade)

  @@unique([monitorId, postId])
  @@index([userId])
  @@index([postId])
}

model Credential {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform String
  data     String

  @@unique([userId, platform])
}

model Payment {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mpPaymentId String?   @unique
  plan        String
  status      String    @default("pending")
  amount      Float
  expiresAt      DateTime?
  gatewayEventId String?
  lastSyncedAt   DateTime?
  createdAt      DateTime  @default(now())

  affiliateCommission AffiliateCommission?

  @@index([status, createdAt])
  @@index([gatewayEventId])
}


model Subscription {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mpSubscriptionId String?   @unique
  plan             String
  status           String    @default("pending")
  nextChargeAt     DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId, status])
}

model PaymentWebhookDlq {
  id             String   @id @default(cuid())
  provider       String
  eventId        String
  requestId      String?
  payload        String
  error          String
  retryCount     Int      @default(0)
  lastRetryAt    DateTime?
  resolvedAt     DateTime?
  createdAt      DateTime @default(now())

  @@index([provider, createdAt])
  @@index([resolvedAt, createdAt])
  @@unique([provider, eventId])
}

model WebhookEvent {
  id               String    @id @default(cuid())
  provider         String
  eventId          String
  eventType        String?
  signatureValid   Boolean   @default(false)
  requestId        String?
  dataId           String?
  payload          String
  processingStatus String    @default("received")
  processedAt      DateTime?
  processingResult String?
  error            String?
  createdAt        DateTime  @default(now())

  @@unique([provider, eventId])
  @@index([provider, createdAt])
  @@index([processingStatus, createdAt])
}

model BotConfig {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  delayMin        Int      @default(5)
  delayMax        Int      @default(15)
  platforms       String   @default("shopee,amazon,mercadolivre,magazineluiza")
  blockedKeywords String   @default("")
  welcomeMsg      String   @default("")
  feedGlobal      Boolean  @default(false)
  postToStatus    Boolean  @default(false)
  brandingGroupLink String   @default("")
  couponLink        String   @default("")
  brandingCtaText String   @default("Participe do grupo:")
  maxDailyFollows         Int     @default(3)
  channelMinIntervalSec   Int     @default(30)
  channelBurstCap         Int     @default(6)
  channelBurstWindowSec   Int     @default(600)
  channelDailyCap         Int?
  channelStaggerJitterMs  Int     @default(90000)
  channelQuietHoursJson   String  @default("{\"startHour\":0,\"endHour\":6,\"tz\":\"America/Sao_Paulo\"}")
  channelThrottleEnabled  Boolean @default(false)
  quietHoursEnabled       Boolean @default(false)
  followGuardEnabled      Boolean @default(false)
  copyVariationEnabled    Boolean @default(false)
  imageMutationEnabled    Boolean @default(true)
  imageMutationActive     Boolean @default(false)
