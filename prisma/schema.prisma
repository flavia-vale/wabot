generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                     String    @id @default(cuid())
  name                   String
  email                  String    @unique
  passwordHash           String
  contactPhone           String?   @unique
  contactPhoneVerifiedAt DateTime?
  contactPhoneOptInAt    DateTime?
  status                 String    @default("active")
  plan                   String    @default("trial")
  accessExpiresAt        DateTime?
  sendCount              Int       @default(0)
  referralCode           String?   @unique
  referredBy             String?
  lastLoginAt            DateTime?
  lastActivityAt         DateTime?
  lastSupportContactAt   DateTime?
  supportStatus          String    @default("new")
  // Por que a conta foi bloqueada ou teve o acesso encerrado, em linguagem
  // leiga. Escrito pela admin e MOSTRADO PARA A CLIENTE (login e painel).
  // As COLUNAS já existem no banco desde a migration
  // 20260909120000_user_blocked_reason — o que faltava aqui era a declaração,
  // perdida na resolução de um conflito. Sem ela o Prisma Client não conhece
  // os campos e `findCurrentUser` (GET /me) lança em toda chamada.
  blockedReason          String?
  blockedAt              DateTime?
  waPhoneOwnerships      WaPhoneOwnership[]
  termsAcceptedAt        DateTime?
  termsVersion           String?
  termsAcceptedIp        String?
  termsAcceptedUserAgent String?
  createdAt              DateTime  @default(now())

  waSession             WaSession?
  waConnectionEvents    WaConnectionEvent[]
  groups                Group[]
  smartLinks            SmartLink[]
  groupTargets          GroupTarget[]
  credentials           Credential[]
  payments              Payment[]
  refunds               Refund[]
  botConfig             BotConfig?
  scheduled             ScheduledMessage[]
  messageLogs           MessageLog[]
  sendDedupKeys         SendDedupKey[]
  adminUser             AdminUser?
  adminAuditActors      AdminAuditLog[]      @relation("AdminAuditActor")
  adminAuditTargets     AdminAuditLog[]      @relation("AdminAuditTarget")
  customerContacts      CustomerContactLog[]
  customerContactActors CustomerContactLog[] @relation("CustomerContactActor")
  followLogs            FollowLog[]
  offerAutomations      OfferAutomation[]
  offerAutomationReviewItems OfferAutomationReviewItem[]
  awinAccounts          AwinAccount[]
  rakutenAccounts       RakutenAccount[]
  clientCoupons         ClientCoupon[]
  offerQueues           OfferQueue[]
  offerQueueItems       OfferQueueItem[]
  affiliateLinks        AffiliateLink[]
  probeEvidences        ProbeEvidence[]
  preservationPresets   PreservationPreset[]
  destinations          Destination[]
  instagramConnections InstagramConnection[]
  storyTemplates        StoryTemplate[]
  storyPublications     StoryPublication[]
  renderedAssets        RenderedAsset[]
  instagramOAuthStates  InstagramOAuthState[]
  instagramStoryIngresses InstagramStoryIngress[]

  affiliateProfileId          String?
  affiliateProfile            AffiliateProfile?           @relation("UserAffiliate")
  affiliateRef                AffiliateProfile?           @relation("AffiliateUser", fields: [affiliateProfileId], references: [id])
  referredCommissions         AffiliateCommission[]       @relation("ReferredUserCommissions")
  paidCommissions             AffiliateCommission[]       @relation("PaidCommissions")
  approvedCommissions         AffiliateCommission[]       @relation("ApprovedCommissions")
  resolvedPayoutRequests      AffiliatePayoutRequest[]    @relation("ResolvedPayoutRequests")
  subscriptions               Subscription[]
  subscriptionCharges         SubscriptionCharge[]
  affiliateAttributionTouches AffiliateAttributionTouch[]
  maxAutomations              Int                         @default(30)

  @@index([status, plan, accessExpiresAt])
  @@index([lastActivityAt])
  @@index([supportStatus])
  @@index([affiliateProfileId])
  @@index([maxAutomations])
}

model WaSession {
  id                 String    @id @default(cuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone              String?
  status             String    @default("disconnected")
  lifecycle          String    @default("idle")
  ownerInstance      String?
  // Nó (servidor) do supervisor dono desta sessão. Nulo = 'n1'. Só é lido com
  // SUPERVISOR_NODE_ROUTING ligado. NÃO confundir com `ownerInstance` (POC de shard).
  nodeId             String?
  lastHeartbeatAt    DateTime?
  lastDisconnectCode String?
  // Aviso que a CLIENTE precisa ler quando a conexão foi recusada por regra
  // nossa (hoje: número já usado em outra conta). JSON curto com o motivo e o
  // e-mail da conta anterior, para a tela oferecer recuperar a senha em vez de
  // virar parede. Nulo = nenhuma recusa pendente.
  blockNotice        String?
  updatedAt          DateTime  @updatedAt

  @@index([status, lastHeartbeatAt])
  @@index([nodeId])
}

// Histórico de qual conta conectou qual número de WhatsApp.
//
// `WaSession.phone` guarda só o número ATUAL e é sobrescrito a cada conexão,
// então até aqui não havia como saber que quatro contas diferentes tinham
// conectado o mesmo número (medido em produção: 12 contas em 4 pessoas). Uma
// linha por par (número, conta) — o mesmo par reconectando só atualiza a data.
model WaPhoneOwnership {
  id              String   @id @default(cuid())
  phone           String
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstConnectedAt DateTime @default(now())
  lastConnectedAt  DateTime @default(now())

  @@unique([phone, userId])
  @@index([phone])
  @@index([userId])
}

model WaConnectionEvent {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String
  code          String?
  lifecycle     String?
  ownerInstance String?
  metadata      String   @default("{}")
  occurredAt    DateTime @default(now())

  @@index([userId, occurredAt])
  @@index([type, occurredAt])
  @@index([occurredAt])
}

model Group {
  id                    String              @id @default(cuid())
  userId                String
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  waJid                 String
  name                  String
  role                  String
  kind                  String              @default("group")
  // Modo de imagem e marca d'água pertencem ao DESTINO (role='post'), nunca à
  // origem — ver src/core/imageModePolicy.js e src/billing/groupEntitlements.js.
  // O campo continua existindo em qualquer role por simplicidade de schema,
  // mas só é lido para grupos role='post'.
  imageMode             String              @default("original")
  watermarkText         String?
  // 'white' | 'black'. Nulo = padrão ('white'). Valor desconhecido cai no
  // padrão no renderizador — marca é enfeite, não pode derrubar o envio.
  watermarkColor        String?
  // 'small' | 'medium' | 'large'. Nulo = padrão ('medium', o tamanho
  // histórico anterior a esta opção). Valor desconhecido cai no padrão.
  watermarkSize         String?
  // 'center' | 'top-left' | 'top-right' | 'bottom-left' | 'bottom-right'.
  // Nulo = padrão ('center'). Valor desconhecido cai no padrão.
  watermarkPosition     String?
  imageLinkTarget       String              @default("first")
  fallbackToOriginal    Boolean             @default(false)
  forwardMode           String              @default("LINK_ONLY")
  noLinkScope           String?
  templateKey           String?
  // Texto opcional anexado ao fim do relay desta origem (texto original com
  // links convertidos). Templates continuam controlando o texto inteiro.
  relayFooterText       String?
  primaryLinkTarget     String?
  blockedKeywords       String?
  allowedPlatforms      String?
  welcomeMsg            String?
  channelButtonJid      String?
  channelButtonName     String?
  quietHoursEnabled     Boolean             @default(false)
  quietHoursJson        String?
  // Plano B (config direcionada): preservação por DESTINO. Vínculo opcional a um
  // preset reutilizável + overrides nuláveis (null = herda do preset). Substitui
  // gradualmente a config global do BotConfig. Ver
  // docs/superpowers/plans/2026-06-22-plano-b-config-direcionada-design.md
  preservationPresetId  String?
  preservationPreset    PreservationPreset? @relation(fields: [preservationPresetId], references: [id], onDelete: SetNull)
  operatingHoursEnabled Boolean?
  operatingHoursJson    String?
  throttleEnabled       Boolean?
  minIntervalSec        Int?
  burstCap              Int?
  burstWindowSec        Int?
  dailyCap              Int?
  queueMaxAgeMin        Int?
  // 'explicit' = a cliente escolheu os destinos desta origem no painel;
  // 'all' (histórico) = nunca escolheu, então espelha para todos os destinos.
  // Sem esse campo, apagar um grupo de destino apagava por cascata os vínculos
  // (GroupTarget) e virava a origem para "todos" em silêncio — RCA 2026-08-26,
  // ver src/core/destinationRouting.js.
  targetsMode           String              @default("all")
  // Feature 017 (arquitetura multicanal de entrega): aplicativo por onde este
  // destino publica, ou de onde esta origem lê. NULO = WhatsApp (todo grupo
  // gravado até esta feature é WhatsApp — FR-013). NUNCA é lido cru: sempre
  // por resolveDeliveryNetwork() (src/core/delivery/networks.js), que
  // devolve 'whatsapp' para nulo e para valor desconhecido. Destino/origem
  // que não é WhatsApp grava `waJid` com prefixo de rede (`tg:<chatId>`) —
  // como nenhum endereço de WhatsApp tem esse formato, `@@unique([userId,
  // waJid, role])` abaixo continua valendo sem alteração (R10). O aplicativo
  // de um destino não pode ser trocado depois de criado.
  deliveryNetwork       String?
  monitorTargets        GroupTarget[]       @relation("MonitorTargets")
  postTargets           GroupTarget[]       @relation("PostTargets")
  channelHealth         ChannelHealth?
  channelThrottle       ChannelThrottle?
  channelSnapshots      ChannelSnapshot[]
  memberSamples         GroupMemberSample[]
  smartLinkGroups       SmartLinkGroup[]
  probeEvidences        ProbeEvidence[]

  instagramMirrorTargets InstagramMirrorDestination[]

  @@unique([userId, waJid, role])
  @@index([userId, kind])
  @@index([preservationPresetId])
}

// Plano B: preset reutilizável de preservação (anti-ban + horário de
// funcionamento), por usuário. Base aplicável a vários destinos; campos setados
// no Group sobrepõem o preset. O preset isDefault semeia novos destinos e é o
// fallback quando o destino não tem preset nem override. A pausa de saúde (403)
// NÃO mora aqui: é reativa, por-destino (ChannelHealth), sempre ligada.
model PreservationPreset {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  isDefault Boolean @default(false)

  // Horário de FUNCIONAMENTO (quando ENVIA). Fora dele = silêncio implícito.
  operatingHoursEnabled Boolean @default(false)
  operatingHoursJson    String  @default("{\"startHour\":8,\"endHour\":22,\"tz\":\"America/Sao_Paulo\"}")

  // Anti-ban (cadência por destino).
  throttleEnabled Boolean @default(true)
  minIntervalSec  Int     @default(30)
  burstCap        Int     @default(6)
  burstWindowSec  Int     @default(600)
  dailyCap        Int?

  // Quando a fila deste destino acumula, descarta o que estiver esperando há
  // mais tempo que isto (em minutos). Oferta velha demais já não serve — e
  // fila infinita derruba a vazão de TODOS os destinos (RCA 2026-07).
  // 0 = nunca descarta. Default 300 (5h).
  queueMaxAgeMin Int @default(300)

  groups    Group[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model GroupTarget {
  id        String @id @default(cuid())
  userId    String
  monitorId String
  postId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  monitor   Group  @relation("MonitorTargets", fields: [monitorId], references: [id], onDelete: Cascade)
  post      Group  @relation("PostTargets", fields: [postId], references: [id], onDelete: Cascade)

  @@unique([monitorId, postId])
  @@index([userId])
  @@index([postId])
}

model Credential {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform String
  data     String

  @@unique([userId, platform])
}

model Payment {
  id                           String    @id @default(cuid())
  userId                       String
  user                         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mpPaymentId                  String?   @unique
  plan                         String
  status                       String    @default("pending")
  amount                       Float
  // Origem contábil do recebimento. Legado/default = Mercado Pago;
  // `manual` identifica pagamentos conferidos e registrados pelo admin.
  provider                     String    @default("mercado_pago")
  paymentMethod                String?
  daysGranted                  Int?
  note                         String?
  expiresAt                    DateTime?
  gatewayEventId               String?
  lastSyncedAt                 DateTime?
  affiliateProfileIdAtCheckout String?
  affiliateClickId             String?
  attributionModel             String?
  attributionLockedAt          DateTime?
  createdAt                    DateTime  @default(now())

  affiliateCommission AffiliateCommission?
  refund               Refund?

  @@index([status, createdAt])
  @@index([provider, createdAt])
  @@index([gatewayEventId])
  @@index([affiliateProfileIdAtCheckout, createdAt])
}

// Reembolso feito fora do gateway (PIX). Mantemos o recebimento original e
// lançamos a devolução separadamente: assim a taxa do Mercado Pago continua
// sendo custo e o resultado real da operação fica negativo no valor da taxa.
model Refund {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentId      String   @unique
  payment        Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  amount         Float
  gatewayFeeLoss Float    @default(0)
  method         String   @default("pix")
  reason         String?
  refundedAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([refundedAt])
  @@index([userId, refundedAt])
}

model Subscription {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mpSubscriptionId String?   @unique
  plan             String
  status           String    @default("pending")
  nextChargeAt     DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId, status])
}

model PaymentWebhookDlq {
  id          String    @id @default(cuid())
  provider    String
  eventId     String
  requestId   String?
  payload     String
  error       String
  retryCount  Int       @default(0)
  lastRetryAt DateTime?
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@unique([provider, eventId])
  @@index([provider, createdAt])
  @@index([resolvedAt, createdAt])
}

model WebhookEvent {
  id               String    @id @default(cuid())
  provider         String
  eventId          String
  eventType        String?
  signatureValid   Boolean   @default(false)
  requestId        String?
  dataId           String?
  payload          String
  processingStatus String    @default("received")
  processedAt      DateTime?
  processingResult String?
  error            String?
  createdAt        DateTime  @default(now())

  @@unique([provider, eventId])
  @@index([provider, createdAt])
  @@index([processingStatus, createdAt])
}

// Uma linha por TENTATIVA de cobrança de assinatura recorrente — inclusive as
// RECUSADAS, que antes não viravam registro nenhum (o webhook de `payment` só
// tratava aprovado e estornado, e o `status_detail` era descartado). Sem isso
// não havia como responder "o que o banco respondeu e quando".
//
// Fonte da verdade é o Mercado Pago: a sincronização horária lê as faturas da
// assinatura (`/authorized_payments/search`) e faz upsert por
// `mpAuthorizedPaymentId`. O webhook grava a mesma linha na hora — os dois
// caminhos convergem para a mesma chave, então avisar duas vezes não duplica.
model SubscriptionCharge {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId        String?
  mpSubscriptionId      String?
  mpAuthorizedPaymentId String?   @unique
  mpPaymentId           String?
  plan                  String?
  amount                Float?
  status                String    @default("unknown")
  statusDetail          String?
  paymentMethod         String?
  retryAttempt          Int?
  attemptedAt           DateTime
  debitedAt             DateTime?
  nextRetryAt           DateTime?
  source                String    @default("mp_sync")
  syncedAt              DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([attemptedAt])
  @@index([status, attemptedAt])
  @@index([userId, attemptedAt])
  @@index([mpSubscriptionId, attemptedAt])
}

model BotConfig {
  id                       String   @id @default(cuid())
  userId                   String   @unique
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  delayMin                 Int      @default(5)
  delayMax                 Int      @default(15)
  platforms                String   @default("shopee,amazon,mercadolivre,magazineluiza,shein,aliexpress,awin,rakuten")
  blockedKeywords          String   @default("")
  welcomeMsg               String   @default("")
  postToStatus             Boolean  @default(false)
  brandingGroupLink        String   @default("")
  couponLink               String   @default("")
  brandingCtaText          String   @default("Participe do grupo:")
  maxDailyFollows          Int      @default(3)
  channelMinIntervalSec    Int      @default(30)
  channelBurstCap          Int      @default(6)
  channelBurstWindowSec    Int      @default(600)
  channelDailyCap          Int?
  channelStaggerJitterMs   Int      @default(0)
  channelQuietHoursJson    String   @default("{\"startHour\":0,\"endHour\":6,\"tz\":\"America/Sao_Paulo\"}")
  channelThrottleEnabled   Boolean  @default(false)
  quietHoursEnabled        Boolean  @default(false)
  followGuardEnabled       Boolean  @default(false)
  copyVariationEnabled     Boolean  @default(false)
  imageMutationEnabled     Boolean  @default(true)
  imageMutationActive      Boolean  @default(false)
  copyVariationPoolJson    String   @default("{\"greetings\":[\"🚨 COOOOOORRE QUE TÁ ACABANDO!\",\"💡 UTILIDADE PÚBLICA!!\",\"😱 TÁ BARATOOO DEMAIS!\",\"🍌 PREÇO DE BANANA!!\",\"🔥 PARA TUDO E OLHA ISSO!\",\"💸 O GERENTE ENLOUQUECEU!!\",\"⚡ OFERTA RELÂMPAGO, CLICA JÁ!\",\"🎁 QUASE DE GRAÇA, SÉRIO!!\",\"💎 ACHADO DE MILHÕES!!\",\"🏃 VOLTOU PRO ESTOQUE, VOA!\",\"💥 CHOCADO COM ESSE VALOR!\",\"🤑 SÓ QUEM FOR RÁPIDO VAI PEGAR!\"],\"ctas\":[\"📲 Entre no nosso grupo oficial:\",\"👥 Vem pro grupo economizar com a gente:\",\"👇 Clique aqui e faça parte do nosso grupo VIP:\",\"🤫 Acesse nosso grupo secreto de ofertas:\",\"🚀 Receba os melhores achadinhos direto no grupo:\",\"🔔 Quer ver as promoções primeiro? Entre no grupo:\",\"💥 Não perca nenhum bug! Faça parte do grupo:\",\"🛒 Garanta os melhores descontos entrando no grupo:\",\"🤝 Junte-se à nossa comunidade de achadinhos:\",\"👀 Para não perder nadinha, vem pro grupo:\"],\"trailers\":[\"⚠️ Atenção: Preços e estoque podem mudar a qualquer momento!\",\"🚨 O valor promocional e a disponibilidade dependem do estoque da loja.\",\"⏳ Corra! Oferta por tempo limitado ou até durarem os estoques.\",\"📝 Preço sujeito a alteração e produto sujeito a esgotar sem aviso prévio.\",\"🏃💨 Garanta logo, porque o estoque voa e o preço pode subir rapidinho!\",\"🔔 Aviso: A loja parceira pode alterar o valor ou encerrar a oferta a qualquer minuto.\",\"🛒 Unidades promocionais limitadas! Preço sujeito a reajuste no site.\",\"📉 Desconto válido por tempo limitado, sujeito a alteração e fim de estoque.\",\"ℹ️ Os preços e a disponibilidade do produto são de responsabilidade total da loja.\",\"💥 Aproveite rápido: Estoques limitados e valores sujeitos a alteração.\"]}")
  probeAccountSessionId    String?
  probeEnabled             Boolean  @default(false)
  mobileTemplatesJson      String   @default("{}")
  mobileCouponLinksJson    String   @default("{}")
  mirrorTemplateKeyDefault String?
  primaryLinkTargetDefault String   @default("first")
  preservationEnabled      Boolean  @default(false)
  // Link rastreado (src/core/trackedLinks.js): o robô troca o link de afiliado
  // pelo shortlink /r/<hash> que conta clique. Opt-in, desligado por padrão;
  // só vale com plano PRO/Trial e SHORTLINK_BASE_URL no servidor.
  clickTrackingEnabled     Boolean  @default(false)
  channelForwardJid        String?
  channelForwardName       String?
  updatedAt                DateTime @updatedAt
}

model FollowLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channelJid String
  status     String
  error      String?
  followedAt DateTime @default(now())

  @@index([userId, followedAt])
}

model ChannelHealth {
  id                  String    @id @default(cuid())
  groupId             String    @unique
  group               Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  status              String    @default("green")
  lastError           String?
  errorRate1h         Float     @default(0)
  latencyP95_1h       Int?
  lastProbeSeenAt     DateTime?
  lastPostedAt        DateTime?
  consecutiveFailures Int       @default(0)
  pausedUntil         DateTime?
  reportRiskScore     Int?
  updatedAt           DateTime  @default(now())

  @@index([status])
}

model ChannelThrottle {
  id                 String    @id @default(cuid())
  groupId            String    @unique
  group              Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  lastPostAt         DateTime?
  burstWindowStart   DateTime?
  postsInBurstWindow Int       @default(0)
  postsToday         Int       @default(0)
  dayBucket          String    @default("")
}

model AffiliateLink {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  hash         String           @unique
  originalUrl  String
  messageLogId String?
  groupId      String?
  createdAt    DateTime         @default(now())
  clicks       AffiliateClick[]

  @@index([userId, createdAt])
  @@index([groupId, createdAt])
}

model AffiliateClick {
  id        String        @id @default(cuid())
  linkId    String
  link      AffiliateLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  clickedAt DateTime      @default(now())
  ipHash    String?
  uaHash    String?

  @@index([linkId, clickedAt])
}

model ChannelSnapshot {
  id           String   @id @default(cuid())
  groupId      String
  group        Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name         String?
  description  String?
  inviteLink   String?
  snapshotJson String
  snapshotedAt DateTime @default(now())

  @@index([groupId, snapshotedAt])
}

model ScheduledMessage {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  text            String
  targetJids      String
  scheduledAt     DateTime
  sentAt          DateTime?
  status          String    @default("pending")
  imageUrl        String?
  imageRefererUrl String?
  // Preço que o Criar oferta leu da loja, em centavos (specs/017). Com ele o
  // robô publica "de X por Y com o cupom" na hora do envio. Null = desconhecido.
  couponPriceCents Int?
  createdAt       DateTime  @default(now())

  @@index([userId, status, scheduledAt])
}

model OfferQueue {
  id                    String           @id @default(cuid())
  userId                String
  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                  String
  enabled               Boolean          @default(true)
  intervalEnabled       Boolean          @default(false)
  intervalMinutes       Int              @default(30)
  hourlyCapEnabled      Boolean          @default(false)
  hourlyCap             Int              @default(10)
  dailyCapEnabled       Boolean          @default(false)
  dailyCap              Int              @default(50)
  // Horário de funcionamento POR FILA (override da janela silenciosa global).
  // Quando operatingHoursEnabled=true, a fila obedece SÓ este horário e ignora
  // a janela silenciosa global (BotConfig). Quando false, segue o global.
  // Horas em "HH:mm", interpretadas em America/Sao_Paulo.
  operatingHoursEnabled Boolean          @default(false)
  operatingHoursStart   String?
  operatingHoursEnd     String?
  // JSON array de JIDs de destino da fila. "[]" = fallback para todos os
  // grupos com role 'post' (comportamento legado, pré-seleção por fila).
  targetJids            String           @default("[]")
  // Distingue fila legada com targetJids=[] (fallback para todos os grupos)
  // de fila Instagram-only (nenhum envio WhatsApp).
  whatsappEnabled       Boolean          @default(true)
  lastSentAt            DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  items                 OfferQueueItem[]
  instagramDestinations OfferQueueDestination[]

  @@index([userId, enabled])
}

model OfferQueueItem {
  id              String     @id @default(cuid())
  queueId         String
  queue           OfferQueue @relation(fields: [queueId], references: [id], onDelete: Cascade)
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  text            String
  imageUrl        String?
  imageRefererUrl String?
  targetJids      String
  offerSnapshot   String?
  status          String     @default("pending")
  position        Int
  sentAt          DateTime?
  // Recuperação de itens presos: claim com lease + retry com backoff.
  // Sem isso, um restart entre o claim (pending->queued) e o envio deixava o
  // item em 'queued' para sempre (o cron só seleciona 'pending').
  claimedAt       DateTime?
  attemptCount    Int        @default(0)
  nextAttemptAt   DateTime?
  lastError       String?
  createdAt       DateTime   @default(now())

  @@index([queueId, status, position])
  @@index([userId, status])
}

model OfferQueueDestination {
  queueId       String
  queue         OfferQueue  @relation(fields: [queueId], references: [id], onDelete: Cascade)
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@id([queueId, destinationId])
  @@index([destinationId])
}

model MessageLog {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform     String
  sourceGroup  String
  destGroup    String
  originalUrl  String
  convertedUrl String
  messageText  String
  // Texto COMPLETO da oferta espelhada (com quebras de linha), guardado só
  // enquanto ela espera na fila: é o que o reenvio pós-restart usa
  // (reprocessRestartFailures). `messageText` é cortado em 240 chars e sem
  // quebras — reenviar dele mandava a oferta mutilada. Zerado quando o envio
  // dá certo, para o banco não crescer. Ver docs/rca/envio-e-filas.md.
  resendText   String?
  status       String   @default("success")
  errorMsg     String?
  // Contador de repostas/duplicatas bloqueadas após a primeira gravação desta
  // (sourceGroup, destGroup, convertedUrl). Em vez de criar N linhas iguais
  // de skip:dedup_recent_link, agregamos no mesmo registro e renderizamos
  // "+N repetições bloqueadas" no painel.
  dedupHits    Int      @default(0)
  // COMO a oferta saiu no grupo (visão admin de qualidade de entrega).
  // Valores em src/core/deliveryKind.js. Nulo = envio anterior ao registro
  // (linha antiga) ou tipo que não passa pelo pipeline de oferta espelhada.
  deliveryKind String?
  // Tamanho, em bytes, da imagem que veio na MENSAGEM DE ORIGEM. 0 = a origem
  // não trouxe imagem nenhuma. É o que separa "saiu sem foto porque não havia
  // foto" de "saiu sem foto mesmo tendo foto na origem" — o caso que a cliente
  // reclama e que antes só aparecia quando ela reclamava.
  originImageBytes Int?
  // Feature 017 (arquitetura multicanal de entrega): por qual aplicativo
  // este envio saiu. NULO = WhatsApp (linha anterior à feature — FR-027).
  // Não confundir com `platform`, que guarda a LOJA (Shopee/Amazon/...).
  deliveryNetwork    String?
  // O que precisou ser reduzido para caber no aplicativo de destino,
  // códigos separados por vírgula (src/core/delivery/neutralOffer.js).
  // NULO = nada foi reduzido. Traduzido para linguagem leiga só na tela.
  deliveryReductions String?
  sentAt       DateTime @default(now())

  sendDedupKeys SendDedupKey[]

  @@index([userId, sentAt])
  @@index([userId, status, sentAt])
  @@index([userId, destGroup, convertedUrl, sentAt])
}

model SendDedupKey {
  id           String      @id @default(cuid())
