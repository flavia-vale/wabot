model OfferAutomation {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  destGroupJid    String?
  destGroupName   String?
  keyword         String
  templateKey     String    @default("automatico_classico")
  intervalMinutes Int
  dailyRunTime    String?
  offersPerSend   Int       @default(1)
  minDiscountPct  Int       @default(0)
  sortType        Int       @default(2)
  listType        Int       @default(1)
  prioritizeAMS   Boolean   @default(false)
  isKeySeller     Boolean   @default(false)
  enabled         Boolean   @default(true)
  publicationMode String    @default("direct")
  lastDiscoveryAt DateTime?
  reviewTargetSize Int      @default(10)
  lastSentAt      DateTime?
  sentItemIds     String    @default("[]")
  // Página atual da busca Shopee. Rotaciona a cada execução para que cada
  // disparo traga candidatos novos em vez de rebater sempre a página 1 (o que
  // causava all_offers_filtered em nichos pequenos já enviados no dia).
  page            Int       @default(1)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  instagramDestinations OfferAutomationDestination[]
  reviewItems OfferAutomationReviewItem[]
  // Opt-in explícito para usar os cupons da cliente (specs/017-client-coupon-catalog).
  // DEFAULT false garante que automação já existente não muda de comportamento
  // sozinha (FR-023/SC-005).
  useCoupons      Boolean   @default(false)
  // De onde vêm as ofertas: "shopee" (busca por palavra-chave, histórico) ou
  // "awin" (promoções já importadas da conta Awin da cliente). Default
  // "shopee" = automação existente não muda de comportamento.
  // Ver docs/rca/afiliados-awin.md.
  source            String    @default("shopee")
  awinAccountId     String?
  // JSON: ids de anunciante (lojas) escolhidos. "[]" = todas as lojas.
  awinAdvertiserIds String    @default("[]")
  // "rakuten": promoções já importadas da conta Rakuten Advertising da
  // cliente (docs/rca/afiliados-rakuten.md). Mesmo desenho da Awin.
  rakutenAccountId     String?
  // JSON: ids de anunciante (lojas) escolhidos. "[]" = todas as lojas.
  rakutenAdvertiserIds String @default("[]")

  @@index([userId, enabled])
  @@index([enabled, lastSentAt])
}

