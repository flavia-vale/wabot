  probeAccountSessionId   String?
  probeEnabled            Boolean @default(false)
  mobileTemplatesJson     String  @default("{}")
  mobileCouponLinksJson   String  @default("{}")
  preservationEnabled     Boolean @default(false)
  updatedAt       DateTime @updatedAt
}

model FollowLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channelJid String
  status     String
  error      String?
  followedAt DateTime @default(now())

  @@index([userId, followedAt])
}

model ChannelHealth {
  id                  String    @id @default(cuid())
  groupId             String    @unique
  group               Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  status              String    @default("green")
  lastError           String?
  errorRate1h         Float     @default(0)
  latencyP95_1h       Int?
  lastProbeSeenAt     DateTime?
  lastPostedAt        DateTime?
  consecutiveFailures Int       @default(0)
  pausedUntil         DateTime?
  reportRiskScore     Int?
  updatedAt           DateTime  @default(now())

  @@index([status])
}

model ChannelThrottle {
  id                 String    @id @default(cuid())
  groupId            String    @unique
  group              Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  lastPostAt         DateTime?
  burstWindowStart   DateTime?
  postsInBurstWindow Int       @default(0)
  postsToday         Int       @default(0)
  dayBucket          String    @default("")
}

model AffiliateLink {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hash         String   @unique
  originalUrl  String
  messageLogId String?
  groupId      String?
  createdAt    DateTime @default(now())
  clicks       AffiliateClick[]

  @@index([userId, createdAt])
  @@index([groupId, createdAt])
}

model AffiliateClick {
  id        String        @id @default(cuid())
  linkId    String
  link      AffiliateLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  clickedAt DateTime      @default(now())
  ipHash    String?
  uaHash    String?

  @@index([linkId, clickedAt])
}

model ChannelSnapshot {
  id           String   @id @default(cuid())
  groupId      String
  group        Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name         String?
  description  String?
  inviteLink   String?
  snapshotJson String
  snapshotedAt DateTime @default(now())

  @@index([groupId, snapshotedAt])
}

model ScheduledMessage {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  text        String
  targetJids  String
  scheduledAt DateTime
  sentAt      DateTime?
  status      String    @default("pending")
  imageUrl    String?
  imageRefererUrl String?
  createdAt   DateTime  @default(now())

  @@index([userId, status, scheduledAt])
}

model OfferQueue {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  enabled          Boolean  @default(true)
  intervalEnabled  Boolean  @default(false)
  intervalMinutes  Int      @default(30)
  hourlyCapEnabled Boolean  @default(false)
  hourlyCap        Int      @default(10)
  dailyCapEnabled  Boolean  @default(false)
  dailyCap         Int      @default(50)
  // JSON array de JIDs de destino da fila. "[]" = fallback para todos os
  // grupos com role 'post' (comportamento legado, pré-seleção por fila).
  targetJids       String   @default("[]")
  lastSentAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  items            OfferQueueItem[]

  @@index([userId, enabled])
}

model OfferQueueItem {
  id              String     @id @default(cuid())
  queueId         String
  queue           OfferQueue @relation(fields: [queueId], references: [id], onDelete: Cascade)
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  text            String
  imageUrl        String?
  imageRefererUrl String?
  targetJids      String
  status          String     @default("pending")
  position        Int
  sentAt          DateTime?
  // Recuperação de itens presos: claim com lease + retry com backoff.
  // Sem isso, um restart entre o claim (pending->queued) e o envio deixava o
  // item em 'queued' para sempre (o cron só seleciona 'pending').
  claimedAt       DateTime?
  attemptCount    Int        @default(0)
  nextAttemptAt   DateTime?
  lastError       String?
  createdAt       DateTime   @default(now())

  @@index([queueId, status, position])
  @@index([userId, status])
}

model MessageLog {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform     String
  sourceGroup  String
  destGroup    String
  originalUrl  String
  convertedUrl String
  messageText  String
  status       String   @default("success")
  errorMsg     String?
  // Contador de repostas/duplicatas bloqueadas após a primeira gravação desta
  // (sourceGroup, destGroup, convertedUrl). Em vez de criar N linhas iguais
  // de skip:dedup_recent_link, agregamos no mesmo registro e renderizamos
  // "+N repetições bloqueadas" no painel.
  dedupHits    Int      @default(0)
  sentAt       DateTime @default(now())

  @@index([userId, sentAt])
  @@index([userId, status, sentAt])
  @@index([userId, destGroup, convertedUrl, sentAt])
}

model AdminUser {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("support")
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLogs        AdminAuditLog[]
  customerContacts CustomerContactLog[]

  @@index([role, status])
}

model AdminAuditLog {
  id           String     @id @default(cuid())
  adminUserId  String?
  adminUser    AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  actorUserId  String?
  actorUser    User?      @relation("AdminAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  targetUserId String?
  targetUser   User?      @relation("AdminAuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  action       String
  resource     String
  resourceId   String?
  before       String?
  after        String?
  reason       String?
  ip           String?
  userAgent    String?
  status       String     @default("success")
  createdAt    DateTime   @default(now())

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([action, createdAt])
}

model CustomerContactLog {
  id             String     @id @default(cuid())
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  adminUserId    String?
  adminUser      AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  actorUserId    String?
  actorUser      User?      @relation("CustomerContactActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  channel        String     @default("whatsapp")
  reason         String
  outcome        String     @default("contacted")
  notes          String?
  nextFollowUpAt DateTime?
  createdAt      DateTime   @default(now())

  @@index([userId, createdAt])
  @@index([adminUserId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([reason, createdAt])
  @@index([outcome, nextFollowUpAt])
}

model FaqItem {
  id        String   @id @default(cuid())
  question  String
  answer    String
  position  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, position])
}

model LpPlan {
  id          String   @id
  title       String
  description String
  price       String
  features    String   @default("[]")
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([position])
}


model TutorialContent {
  id        String   @id
  title     String
  body      String
  images    String   @default("[]")
  updatedAt DateTime @updatedAt
}

model LegalDocument {
  id              String   @id
  title           String
  summary         String
  contentJson     String   @default("{}")
  version         String
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AnalyticsEvent {
  id        String   @id
  userId    String?
  event     String
  metadata  String   @default("{}")
  createdAt DateTime @default(now())

  @@index([event, createdAt])
  @@index([userId, createdAt])
}


model ProbeEvidence {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId            String
  group              Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  probeSessionId     String
  messageFingerprint String
  sentAt             DateTime
  seenAt             DateTime
  latencyMs          Int
  matchSource        String   @default("manual-ping-fallback")
  createdAt          DateTime @default(now())

  @@index([userId, groupId, seenAt])
  @@index([groupId, messageFingerprint])
}

model TelegramOfferLog {
  id        String   @id @default(cuid())
  chatId    String
  inputUrl  String
  platform  String?
  status    String
  withImage Boolean  @default(false)
  errorMsg  String?
  latencyMs Int?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([status, createdAt])
  @@index([platform, createdAt])
}

model OfferAutomation {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  destGroupJid    String
  destGroupName   String
  keyword         String
  templateKey     String    @default("automatico_classico")
  intervalMinutes Int
  dailyRunTime    String?
  offersPerSend   Int       @default(1)
  minDiscountPct  Int       @default(0)
  sortType        Int       @default(2)
  listType        Int       @default(1)
  prioritizeAMS   Boolean   @default(false)
  isKeySeller     Boolean   @default(false)
  enabled         Boolean   @default(true)
  lastSentAt      DateTime?
  sentItemIds     String    @default("[]")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId, enabled])
  @@index([enabled, lastSentAt])
}

// Dedup cruzada entre automações, por grupo de destino. `sentItemIds` é
// per-automação, então N automações apontando pro mesmo grupo reenviavam o
// MESMO produto (uma vez por automação). Aqui registramos cada produto
// enviado a um grupo COM o preço; antes de enviar, o dispatcher pula se o
// mesmo (userId, destGroupJid, productKey, priceCents) saiu nas últimas 24h.
// Se o PREÇO mudou, a oferta passa (é uma oferta nova de fato — relâmpago da
// manhã a R$X vs. da tarde a R$Y).
model OfferAutomationSentLog {
  id           String   @id @default(cuid())
  userId       String
  destGroupJid String
  productKey   String
  priceCents   Int
  itemId       String?
  sentAt       DateTime @default(now())

  @@index([userId, destGroupJid, sentAt])
}

model AffiliateSettings {
  id                         Int     @id @default(1)
  cookieDurationHours        Int     @default(24)
  commissionPercent          Int     @default(30)
  commissionRecurringPercent Int     @default(30)
  recurringCommissionEnabled Boolean @default(true)
}

model AffiliateProfile {
  id                                 String    @id @default(cuid())
  userId                             String    @unique
  code                               String    @unique
  status                             String    @default("pending")
  pixKey                             String
  pixKeyType                         String
  appliedAt                          DateTime  @default(now())
  approvedAt                         DateTime?
  rejectedAt                         DateTime?
  adminNotes                         String?
  commissionPercentOverride          Int?
  commissionRecurringPercentOverride Int?

  user         User                  @relation("UserAffiliate", fields: [userId], references: [id], onDelete: Cascade)
  referredUser User?                 @relation("AffiliateUser")
  commissions  AffiliateCommission[]

  @@index([status])
}

model AffiliateCommission {
  id                    String    @id @default(cuid())
  affiliateId           String
  paymentId             String    @unique
  referredUserId        String
  saleAmountCents       Int
  commissionAmountCents Int
  commissionType        String    @default("initial")
  commissionRatePct     Int       @default(30)
  status                String    @default("pending")
  cycleMonth            String
  paidAt                DateTime?
  paidByUserId          String?
  createdAt             DateTime  @default(now())

  affiliate    AffiliateProfile @relation(fields: [affiliateId], references: [id])
  payment      Payment          @relation(fields: [paymentId], references: [id])
  referredUser User             @relation("ReferredUserCommissions", fields: [referredUserId], references: [id])
  paidBy       User?            @relation("PaidCommissions", fields: [paidByUserId], references: [id])

  @@index([affiliateId, cycleMonth, status])
  @@index([referredUserId])
}
