generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                     String    @id @default(cuid())
  email                  String    @unique
  passwordHash           String
  contactPhone           String?
  contactPhoneVerifiedAt DateTime?
  contactPhoneOptInAt    DateTime?
  status                 String    @default("active")
  plan                   String    @default("trial")
  trialExpiresAt         DateTime?
  sendCount              Int       @default(0)
  referralCode           String?   @unique
  referredBy             String?
  lastLoginAt            DateTime?
  lastActivityAt         DateTime?
  lastSupportContactAt   DateTime?
  supportStatus          String    @default("new")
  createdAt              DateTime  @default(now())

  waSession         WaSession?
  groups            Group[]
  credentials       Credential[]
  payments          Payment[]
  botConfig         BotConfig?
  scheduled         ScheduledMessage[]
  messageLogs       MessageLog[]
  adminUser         AdminUser?
  adminAuditActors  AdminAuditLog[]    @relation("AdminAuditActor")
  adminAuditTargets AdminAuditLog[]    @relation("AdminAuditTarget")

  @@index([status, plan, trialExpiresAt])
  @@index([lastActivityAt])
  @@index([supportStatus])
}

model WaSession {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone     String?
  status    String   @default("disconnected")
  updatedAt DateTime @updatedAt
}

model Group {
  id                 String  @id @default(cuid())
  userId             String
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  waJid              String
  name               String
  role               String
  imageMode          String  @default("none")
  imageLinkTarget    String  @default("first")
  fallbackToOriginal Boolean @default(false)

  @@unique([userId, waJid, role])
}

model Credential {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform String
  data     String

  @@unique([userId, platform])
}

model Payment {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mpPaymentId String?   @unique
  plan        String
  status      String    @default("pending")
  amount      Float
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
}

model BotConfig {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  delayMin        Int      @default(5)
  delayMax        Int      @default(15)
  platforms       String   @default("shopee,amazon,mercadolivre,magazineluiza")
  blockedKeywords String   @default("")
  welcomeMsg      String   @default("")
  updatedAt       DateTime @updatedAt
}

model ScheduledMessage {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  text        String
  targetJids  String
  scheduledAt DateTime
  sentAt      DateTime?
  status      String    @default("pending")
  createdAt   DateTime  @default(now())

  @@index([userId, status, scheduledAt])
}

model MessageLog {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform     String
  sourceGroup  String
  destGroup    String
  originalUrl  String
  convertedUrl String
  messageText  String
  status       String   @default("success")
  errorMsg     String?
  sentAt       DateTime @default(now())

  @@index([userId, sentAt])
  @@index([userId, status, sentAt])
}

model AdminUser {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("support")
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLogs AdminAuditLog[]

  @@index([role, status])
}

model AdminAuditLog {
  id           String     @id @default(cuid())
  adminUserId  String?
  adminUser    AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  actorUserId  String?
  actorUser    User?      @relation("AdminAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  targetUserId String?
  targetUser   User?      @relation("AdminAuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  action       String
  resource     String
  resourceId   String?
  before       String?
  after        String?
  reason       String?
  ip           String?
  userAgent    String?
  status       String     @default("success")
  createdAt    DateTime   @default(now())

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([action, createdAt])
}
