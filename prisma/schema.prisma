  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status            String   @default("awaiting_review")
  productKey        String
  itemId            String?
  priceCents        Int
  productUrl        String
  imageUrl          String?
  imageRefererUrl   String?
  productSnapshot   String
  renderedText      String
  targetSnapshot    String
  deliverySnapshot  String   @default("{}")
  position          Int
  discoveredAt      DateTime @default(now())
  reviewedAt        DateTime?
  reviewedAction    String?
  sentAt            DateTime?
  claimedAt         DateTime?
  attemptCount      Int      @default(0)
  nextAttemptAt     DateTime?
  lastError         String?
  expiresAt         DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([automationId, status, position])
  @@index([userId, status, createdAt])
  @@index([automationId, productKey, priceCents])
}

// Cupom de desconto cadastrado pela própria cliente, para uso nas ofertas
// (specs/017-client-coupon-catalog). Escopado por cliente (onDelete: Cascade).
// Código repetido é PERMITIDO de propósito — não há índice único em
// (userId, platform, code); a tela apenas avisa.
model ClientCoupon {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 'code' (a pessoa digita no carrinho) ou 'link' (entra e resgata no site).
  kind          String    @default("code")
  // Cupom de link grava '' aqui: a coluna é obrigatória desde a criação, e
  // torná-la opcional exigiria recriar a tabela (migration só aditiva).
  code          String
  // Link de resgate do cupom de link — sempre um endereço da própria loja.
  redeemUrl     String?
  label         String?
  platform      String
  discountType  String
  discountValue Int
  // Opcionais, em centavos: compra mínima (os dois tipos) e teto de desconto
  // (só faz sentido no tipo %). Null = sem essa condição.
  minPurchaseCents Int?
  maxDiscountCents Int?
  validUntil    DateTime?
  enabled       Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId, enabled])
  @@index([userId, platform])
}

// Dedup cruzada entre automações, por grupo de destino. `sentItemIds` é
// per-automação, então N automações apontando pro mesmo grupo reenviavam o
// MESMO produto (uma vez por automação). Aqui registramos cada produto
// enviado a um grupo COM o preço; antes de enviar, o dispatcher pula se o
// mesmo (userId, destGroupJid, productKey, priceCents) saiu nas últimas 24h.
// Se o PREÇO mudou, a oferta passa (é uma oferta nova de fato — relâmpago da
// manhã a R$X vs. da tarde a R$Y).
model OfferAutomationSentLog {
  id           String   @id @default(cuid())
  userId       String
  destGroupJid String
  productKey   String
  priceCents   Int
  itemId       String?
  sentAt       DateTime @default(now())

  @@index([userId, destGroupJid, sentAt])
}

// Destinos multicanal coexistem com Group durante a migração progressiva.
// providerRef nunca contém token; para Instagram aponta à conta profissional.
// Amostra horária do total de membros de um grupo (só quantidade — nunca
// números de telefone). Base do painel "Membros" e do futuro rodízio de convites.
model GroupMemberSample {
  id        String   @id @default(cuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  size      Int
  sampledAt DateTime @default(now())

  @@index([groupId, sampledAt])
}

// Link Inteligente: um endereço público (/g/<slug>) que redireciona para o
// convite do grupo MAIS VAZIO entre os cadastrados (rodízio). Ver
// docs/rca/grupos-membros.md.
model SmartLink {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  slug         String           @unique
  enabled      Boolean          @default(true)
  capPerGroup  Int              @default(1000)
  // Apagar NÃO libera o endereço: ele já foi divulgado e outra pessoa que o
  // pegasse receberia o tráfego. Só a mesma dona pode reativá-lo.
  deletedAt    DateTime?
  // Avisos de "link enchendo" (PR 3): por canal, desligáveis pela cliente.
  notifyEmail      Boolean   @default(true)
  notifyWhatsapp   Boolean   @default(true)
  // Estado do aviso (controle de repetição): ver src/core/smartLinkAlertPolicy.js.
  alertKind        String?   // 'warn' | 'urgent' enquanto há um episódio aberto
  alertLastSentAt  DateTime?
  alertReminders   Int       @default(0)
  alertActiveGroups Int?     // grupos ativos quando avisou (grupo novo rearma)
  groups       SmartLinkGroup[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([userId])
}

model SmartLinkGroup {
  id          String               @id @default(cuid())
  smartLinkId String
  smartLink   SmartLink            @relation(fields: [smartLinkId], references: [id], onDelete: Cascade)
  groupId     String
  group       Group                @relation(fields: [groupId], references: [id], onDelete: Cascade)
  // Código do convite (parte final de chat.whatsapp.com/<código>). Nulo = sem
  // convite válido; o grupo fica fora do rodízio.
  inviteCode  String?
  enabled     Boolean              @default(true)
  dailyClicks SmartLinkDailyClick[]
  createdAt   DateTime             @default(now())

  @@unique([smartLinkId, groupId])
  @@index([groupId])
}

// Cliques por grupo por dia (fuso de São Paulo). Contador, não um registro por
// clique: o link é divulgado em muitos lugares e o volume pode ser grande.
model SmartLinkDailyClick {
  id               String         @id @default(cuid())
  smartLinkGroupId String
  smartLinkGroup   SmartLinkGroup @relation(fields: [smartLinkGroupId], references: [id], onDelete: Cascade)
  day              String
  clicks           Int            @default(0)

  @@unique([smartLinkGroupId, day])
}

model Destination {
