generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                     String    @id @default(cuid())
  name                   String
  email                  String    @unique
  passwordHash           String
  contactPhone           String?   @unique
  contactPhoneVerifiedAt DateTime?
  contactPhoneOptInAt    DateTime?
  status                 String    @default("active")
  plan                   String    @default("trial")
  accessExpiresAt        DateTime?
  sendCount              Int       @default(0)
  referralCode           String?   @unique
  referredBy             String?
  lastLoginAt            DateTime?
  lastActivityAt         DateTime?
  lastSupportContactAt   DateTime?
  supportStatus          String    @default("new")
  createdAt              DateTime  @default(now())

  waSession             WaSession?
  groups                Group[]
  groupTargets          GroupTarget[]
  credentials           Credential[]
  payments              Payment[]
  botConfig             BotConfig?
  scheduled             ScheduledMessage[]
  messageLogs           MessageLog[]
  adminUser             AdminUser?
  adminAuditActors      AdminAuditLog[]      @relation("AdminAuditActor")
  adminAuditTargets     AdminAuditLog[]      @relation("AdminAuditTarget")
  customerContacts      CustomerContactLog[]
  customerContactActors CustomerContactLog[] @relation("CustomerContactActor")

  @@index([status, plan, accessExpiresAt])
  @@index([lastActivityAt])
  @@index([supportStatus])
}

model WaSession {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone            String?
  status           String   @default("disconnected")
  lifecycle        String   @default("idle")
  ownerInstance    String?
  lastHeartbeatAt  DateTime?
  lastDisconnectCode String?
  updatedAt        DateTime @updatedAt

  @@index([status, lastHeartbeatAt])
}

model Group {
  id                 String  @id @default(cuid())
  userId             String
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  waJid              String
  name               String
  role               String
  imageMode          String  @default("none")
  imageLinkTarget    String  @default("first")
  fallbackToOriginal Boolean @default(false)
  blockedKeywords   String?
  allowedPlatforms  String?
  welcomeMsg        String?
  monitorTargets   GroupTarget[] @relation("MonitorTargets")
  postTargets      GroupTarget[] @relation("PostTargets")

  @@unique([userId, waJid, role])
}

model GroupTarget {
  id        String @id @default(cuid())
  userId    String
  monitorId String
  postId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  monitor   Group  @relation("MonitorTargets", fields: [monitorId], references: [id], onDelete: Cascade)
  post      Group  @relation("PostTargets", fields: [postId], references: [id], onDelete: Cascade)

  @@unique([monitorId, postId])
  @@index([userId])
  @@index([postId])
}

model Credential {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform String
  data     String

  @@unique([userId, platform])
}

model Payment {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mpPaymentId String?   @unique
  plan        String
  status      String    @default("pending")
  amount      Float
  expiresAt      DateTime?
  gatewayEventId String?
  lastSyncedAt   DateTime?
  createdAt      DateTime  @default(now())

  @@index([status, createdAt])
  @@index([gatewayEventId])
}


model PaymentWebhookDlq {
  id             String   @id @default(cuid())
  provider       String
  eventId        String
  requestId      String?
  payload        String
  error          String
  retryCount     Int      @default(0)
  lastRetryAt    DateTime?
  resolvedAt     DateTime?
  createdAt      DateTime @default(now())

  @@index([provider, createdAt])
  @@index([resolvedAt, createdAt])
  @@unique([provider, eventId])
}

model WebhookEvent {
  id               String    @id @default(cuid())
  provider         String
  eventId          String
  eventType        String?
  signatureValid   Boolean   @default(false)
  requestId        String?
  dataId           String?
  payload          String
  processingStatus String    @default("received")
  processedAt      DateTime?
  processingResult String?
  error            String?
  createdAt        DateTime  @default(now())

  @@unique([provider, eventId])
  @@index([provider, createdAt])
  @@index([processingStatus, createdAt])
}

model BotConfig {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  delayMin        Int      @default(5)
  delayMax        Int      @default(15)
  platforms       String   @default("shopee,amazon,mercadolivre,magazineluiza")
  blockedKeywords String   @default("")
  welcomeMsg      String   @default("")
  feedGlobal      Boolean  @default(false)
  postToStatus    Boolean  @default(false)
  updatedAt       DateTime @updatedAt
}

model ScheduledMessage {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  text        String
  targetJids  String
  scheduledAt DateTime
  sentAt      DateTime?
  status      String    @default("pending")
  createdAt   DateTime  @default(now())

  @@index([userId, status, scheduledAt])
}

model MessageLog {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform     String
  sourceGroup  String
  destGroup    String
  originalUrl  String
  convertedUrl String
  messageText  String
  status       String   @default("success")
  errorMsg     String?
  sentAt       DateTime @default(now())

  @@index([userId, sentAt])
  @@index([userId, status, sentAt])
}

model AdminUser {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("support")
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLogs        AdminAuditLog[]
  customerContacts CustomerContactLog[]

  @@index([role, status])
}

model AdminAuditLog {
  id           String     @id @default(cuid())
  adminUserId  String?
  adminUser    AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  actorUserId  String?
  actorUser    User?      @relation("AdminAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  targetUserId String?
  targetUser   User?      @relation("AdminAuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  action       String
  resource     String
  resourceId   String?
  before       String?
  after        String?
  reason       String?
  ip           String?
  userAgent    String?
  status       String     @default("success")
  createdAt    DateTime   @default(now())

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([action, createdAt])
}

model CustomerContactLog {
  id             String     @id @default(cuid())
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  adminUserId    String?
  adminUser      AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  actorUserId    String?
  actorUser      User?      @relation("CustomerContactActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  channel        String     @default("whatsapp")
  reason         String
  outcome        String     @default("contacted")
  notes          String?
  nextFollowUpAt DateTime?
  createdAt      DateTime   @default(now())

  @@index([userId, createdAt])
  @@index([adminUserId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([reason, createdAt])
  @@index([outcome, nextFollowUpAt])
}

model FaqItem {
  id        String   @id @default(cuid())
  question  String
  answer    String
  position  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, position])
}

model LpPlan {
  id          String   @id
  title       String
  description String
  price       String
  features    String   @default("[]")
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([position])
}


model TutorialContent {
  id        String   @id
  title     String
  body      String
  images    String   @default("[]")
  updatedAt DateTime @updatedAt
}
